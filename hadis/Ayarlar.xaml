<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:hadis.Controls"
             x:Class="hadis.Ayarlar"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0B101B"
             Title="Ayarlar">

    <Grid Padding="0" Margin="0">
        <!-- Dinamik Saat Bazlı Arkaplan (Ana sayfa ile senkronize) -->
        <Image x:Name="BackgroundImage"
               Aspect="AspectFill"
               Scale="1.05"
               HorizontalOptions="FillAndExpand"
               VerticalOptions="FillAndExpand">
            <Image.Source>
                <AppThemeBinding Light="bg_light.jpg" Dark="ayarlararkaplan.webp" />
            </Image.Source>
        </Image>

        <!-- Tema Arkaplan Overlay (BackgroundService tarafından yönetilir) -->
        <Grid x:Name="BackgroundOverlay"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand"
              IsVisible="False" />

        <!-- Atmosferik Gradyan Vignette Overlay -->
        <BoxView HorizontalOptions="FillAndExpand"
                 VerticalOptions="FillAndExpand"
                 InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#73082F49" Offset="0.0" />
                    <GradientStop Color="#990F172A" Offset="0.45" />
                    <GradientStop Color="#F20B111E" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- İçerik Alanı -->
        <ScrollView x:Name="MainContentGrid"
                    VerticalScrollBarVisibility="Never"
                    HorizontalScrollBarVisibility="Never"
                    Padding="20,24,20,126">
            <VerticalStackLayout Spacing="16">

                <!-- Üst Başlık ve Konum Özeti Rozeti -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,4">
                    <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                            <Ellipse WidthRequest="8"
                                     HeightRequest="8"
                                     Fill="#34D399"
                                     VerticalOptions="Center" />
                            <Label Text="UYGULAMA TERCİHLERİ"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.1"
                                   TextColor="#CCBAE6FD"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label x:Name="AyarlarTitle"
                               Text="Ayarlar"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="White">
                            <Label.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.4" />
                            </Label.Shadow>
                        </Label>
                    </VerticalStackLayout>

                    <!-- Sağ Konum Rozeti -->
                    <Border Grid.Column="1"
                            VerticalOptions="Center"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="1"
                            Stroke="#33FFFFFF"
                            BackgroundColor="#14FFFFFF"
                            Padding="11,8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="KonumButton_Clicked" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="9" VerticalOptions="Center">
                            <Border WidthRequest="28"
                                    HeightRequest="28"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                        <GradientStop Color="#38BDF8" Offset="0.0" />
                                        <GradientStop Color="#6366F1" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label Text="📍"
                                       FontSize="13"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                <Label x:Name="HeaderLocationLabel"
                                       Text="Konum Seç"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#E6FFFFFF"
                                       LineBreakMode="TailTruncation"
                                       MaximumWidthRequest="110" />
                                <Label Text="Diyanet Takvimi"
                                       FontSize="9"
                                       TextColor="#B3BAE6FD" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- BÖLÜM 1: KONUM & VAKİT AYARLARI -->
                <Border x:Name="KonumFrame"
                        StrokeShape="RoundRectangle 24"
                        StrokeThickness="1"
                        Stroke="#2EFFFFFF"
                        BackgroundColor="#14FFFFFF"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,10" Radius="24" Opacity="0.3" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    WidthRequest="38"
                                    HeightRequest="38"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="1"
                                    Stroke="#6638BDF8"
                                    BackgroundColor="#400EA5E9"
                                    VerticalOptions="Center">
                                <Label Text="📍" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label x:Name="KonumTitle"
                                       Text="Konum &amp; Vakit Ayarları"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label Text="Diyanet İşleri Başkanlığı takvimi"
                                       FontSize="11"
                                       TextColor="#B3E0F2FE" />
                            </VerticalStackLayout>

                            <Border x:Name="GpsStatusBadge"
                                    Grid.Column="2"
                                    VerticalOptions="Center"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Stroke="#4D34D399"
                                    BackgroundColor="#3310B981"
                                    Padding="9,4">
                                <Label x:Name="GpsStatusLabel"
                                       Text="Manuel Seçim"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="#6EE7B7" />
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#1AFFFFFF" />

                        <!-- Konum Seçici Satırı -->
                        <Border StrokeShape="RoundRectangle 16"
                                StrokeThickness="1"
                                Stroke="#14FFFFFF"
                                BackgroundColor="#0DFFFFFF"
                                Padding="12,11">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="KonumButton_Clicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                    <Label Text="Seçili Şehir:"
                                           FontSize="12"
                                           TextColor="#E6FFFFFF"
                                           VerticalOptions="Center" />
                                    <Label x:Name="SeciliKonumLabel"
                                           Text="Seçilmedi"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#7DD3FC"
                                           VerticalOptions="Center"
                                           LineBreakMode="TailTruncation" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="Değiştir"
                                           FontSize="12"
                                           TextColor="#CCBAE6FD"
                                           VerticalOptions="Center" />
                                    <Label Text="›"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#CCBAE6FD"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- BÖLÜM 2: EZAN & BİLDİRİMLER -->
                <Border x:Name="BildirimFrame"
                        StrokeShape="RoundRectangle 24"
                        StrokeThickness="1"
                        Stroke="#2EFFFFFF"
                        BackgroundColor="#14FFFFFF"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,10" Radius="24" Opacity="0.3" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    WidthRequest="38"
                                    HeightRequest="38"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="1"
                                    Stroke="#66FBBF24"
                                    BackgroundColor="#40F59E0B"
                                    VerticalOptions="Center">
                                <Label Text="🔔" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label x:Name="BildirimTitle"
                                       Text="Ezan &amp; Bildirimler"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label Text="Vakit girişinde sesli ve sessiz ikazlar"
                                       FontSize="11"
                                       TextColor="#B3FEF3C7" />
                            </VerticalStackLayout>
                        </Grid>

                        <Border StrokeShape="RoundRectangle 16"
                                StrokeThickness="1"
                                Stroke="#14FFFFFF"
                                BackgroundColor="#0DFFFFFF"
                                Padding="12,11">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="BildirimButton_Clicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Bildirim Ayarları"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                    <Label x:Name="BildirimSubtitle"
                                           Text="Ezan vakti bildirimleri ve hatırlatıcı sesleri"
                                           FontSize="11"
                                           TextColor="#99FFFFFF" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="›"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#80FFFFFF"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- BÖLÜM 3: GÖRÜNÜM & ATMOSFER -->
                <Border x:Name="TemaFrame"
                        StrokeShape="RoundRectangle 24"
                        StrokeThickness="1"
                        Stroke="#2EFFFFFF"
                        BackgroundColor="#14FFFFFF"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,10" Radius="24" Opacity="0.3" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    WidthRequest="38"
                                    HeightRequest="38"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="1"
                                    Stroke="#66818CF8"
                                    BackgroundColor="#406366F1"
                                    VerticalOptions="Center">
                                <Label Text="🎨" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label x:Name="TemaTitle"
                                       Text="Görünüm &amp; Atmosfer"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label Text="Dinamik vakit arka planı ve tema tercihleri"
                                       FontSize="11"
                                       TextColor="#B3E0E7FF" />
                            </VerticalStackLayout>
                        </Grid>

                        <Border StrokeShape="RoundRectangle 16"
                                StrokeThickness="1"
                                Stroke="#14FFFFFF"
                                BackgroundColor="#0DFFFFFF"
                                Padding="12,11">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TemaButton_Clicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Tema Ayarları"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                    <Label x:Name="TemaSubtitle"
                                           Text="Açık, koyu, özel temalar ve renk paletleri"
                                           FontSize="11"
                                           TextColor="#99FFFFFF" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="›"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#80FFFFFF"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- BÖLÜM 4: İBADET & YARDIMCI ARAÇLAR -->
                <Border StrokeShape="RoundRectangle 24"
                        StrokeThickness="1"
                        Stroke="#2EFFFFFF"
                        BackgroundColor="#14FFFFFF"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,10" Radius="24" Opacity="0.3" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,2">
                            <Border Grid.Column="0"
                                    WidthRequest="38"
                                    HeightRequest="38"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="1"
                                    Stroke="#6634D399"
                                    BackgroundColor="#4010B981"
                                    VerticalOptions="Center">
                                <Label Text="🕌" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label Text="İbadet &amp; Yardımcı Araçlar"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label Text="Kur'an, takvim, yakındaki camiler ve widget"
                                       FontSize="11"
                                       TextColor="#B3D1FAE5" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Kur'an-ı Kerim -->
                        <Border x:Name="KuranFrame"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="1"
                                Stroke="#14FFFFFF"
                                BackgroundColor="#0DFFFFFF"
                                Padding="12,11">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="KuranButton_Clicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="📖" FontSize="18" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label x:Name="KuranTitle"
                                           Text="Kur'an-ı Kerim"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                    <Label x:Name="KuranSubtitle"
                                           Text="Meal okuma, sureler ve ayet arama"
                                           FontSize="11"
                                           TextColor="#99FFFFFF" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="18" FontAttributes="Bold" TextColor="#80FFFFFF" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Hicri Takvim -->
                        <Border x:Name="HicriTakvimFrame"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="1"
                                Stroke="#14FFFFFF"
                                BackgroundColor="#0DFFFFFF"
                                Padding="12,11">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="HicriTakvimButton_Clicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="📅" FontSize="18" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label x:Name="HicriTakvimTitle"
                                           Text="Hicri Takvim"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                    <Label x:Name="HicriTakvimSubtitle"
                                           Text="İslami takvim, dini gün ve kandil tarihleri"
                                           FontSize="11"
                                           TextColor="#99FFFFFF" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="18" FontAttributes="Bold" TextColor="#80FFFFFF" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Yakındaki Camiler -->
                        <Border x:Name="CamilerFrame"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="1"
                                Stroke="#14FFFFFF"
                                BackgroundColor="#0DFFFFFF"
                                Padding="12,11">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="YakinCamilerButton_Clicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="🕌" FontSize="18" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label x:Name="CamilerTitle"
                                           Text="Yakındaki Camiler"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                    <Label x:Name="CamilerSubtitle"
                                           Text="Harita üzerinde yakınınızdaki camileri görün"
                                           FontSize="11"
                                           TextColor="#99FFFFFF" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="18" FontAttributes="Bold" TextColor="#80FFFFFF" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Widget Ayarları -->
                        <Border x:Name="WidgetFrame"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="1"
                                Stroke="#14FFFFFF"
                                BackgroundColor="#0DFFFFFF"
                                Padding="12,11"
                                Opacity="0.8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="WidgetButton_Clicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="📱" FontSize="18" VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       x:Name="WidgetTitle"
                                       Text="Widget Ayarları"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       VerticalOptions="Center" />
                                <Border Grid.Column="2"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="#4DF59E0B"
                                        BackgroundColor="#33F59E0B"
                                        Padding="8,2"
                                        VerticalOptions="Center">
                                    <Label Text="Yakında"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="#FCD34D" />
                                </Border>
                                <Label Grid.Column="3" Text="›" FontSize="18" FontAttributes="Bold" TextColor="#80FFFFFF" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- BÖLÜM 5: HAKKINDA & VERSİYON BİLGİSİ -->
                <Border x:Name="HakkindaFrame"
                        StrokeShape="RoundRectangle 22"
                        StrokeThickness="1"
                        Stroke="#1FFFFFFF"
                        BackgroundColor="#12FFFFFF"
                        Padding="16">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Border StrokeShape="RoundRectangle 12"
                                Padding="14,7"
                                BackgroundColor="#14FFFFFF"
                                Stroke="#26FFFFFF"
                                HorizontalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="GizlilikPolitikasi_Tapped" />
                            </Border.GestureRecognizers>
                            <Label x:Name="GizlilikPolitikasiLabel"
                                   Text="🔒 Gizlilik Politikası"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#E6FFFFFF"
                                   HorizontalOptions="Center" />
                        </Border>

                        <Label x:Name="VersionLabel"
                               Text="İbadet Vakti • Versiyon 1.0.0"
                               FontSize="11"
                               HorizontalOptions="Center"
                               TextColor="#80FFFFFF" />

                        <Label x:Name="CopyrightLabel"
                               Text="© 2026 İbadet Vakti Uygulaması"
                               FontSize="10"
                               HorizontalOptions="Center"
                               TextColor="#66FFFFFF" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Özel Yüzen TabBar -->
        <controls:CustomTabBar CurrentTab="Ayarlar" ZIndex="10" />

    </Grid>
</ContentPage>
