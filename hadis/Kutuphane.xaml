<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:hadis.Controls"
             x:Class="hadis.Kutuphane"
             Title="Kütüphane">
    
    <Grid>
        <!-- Arka Plan Görseli -->
        <Image x:Name="BackgroundImage"
               Aspect="AspectFill"
               HorizontalOptions="FillAndExpand"
               VerticalOptions="FillAndExpand">
            <Image.Source>
                <AppThemeBinding Light="bg_light.jpg" Dark="ayarlararkaplan.webp" />
            </Image.Source>
        </Image>
        
        <!-- Arka Plan Karartma Overlay -->
        <BoxView HorizontalOptions="FillAndExpand"
                 VerticalOptions="FillAndExpand">
            <BoxView.Color>
                <AppThemeBinding Light="White" Dark="Black" />
            </BoxView.Color>
            <BoxView.Opacity>
                <AppThemeBinding Light="0.75" Dark="0.45" />
            </BoxView.Opacity>
        </BoxView>
        
        <!-- İçerik Alanı -->
        <Grid x:Name="MainContentGrid" RowDefinitions="Auto, *" Padding="20,15,20,0">
            <!-- Sabit Header (Aşağı kaysa bile yukarıda kalır) -->
            <Border Grid.Row="0"
                    x:Name="HeaderFrame"
                    StrokeShape="RoundRectangle 24"
                    Padding="24,20"
                    Margin="0,0,0,15"
                    Stroke="{AppThemeBinding Light=#4000796B, Dark=#30FFFFFF}"
                    BackgroundColor="{AppThemeBinding Light=#44FFFFFF, Dark=#33000000}">
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="İslami Kütüphane"
                           FontSize="26"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#00796B, Dark=#FFFFFF}"/>
                    
                    <Label Text="Kur'an-ı Kerim, Mealler ve İbadet Rehberleri"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#555555, Dark=#BDBDBD}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Kaydırılabilir İçerik Listesi -->
            <ScrollView Grid.Row="1"
                        VerticalScrollBarVisibility="Never"
                        HorizontalScrollBarVisibility="Never"
                        Padding="0,0,0,90">
                <VerticalStackLayout Spacing="22">

                    <!-- BÖLÜM 1: KUR'AN-I KERİM & MEALLER -->
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto, *" Margin="4,0,0,0">
                            <Label Text="📖" FontSize="16" VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="KUR'AN-I KERİM &amp; MEALLER"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="{AppThemeBinding Light=#00796B, Dark=#80CBC4}"
                                   Margin="8,0,0,0"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- Kur'an-ı Kerim ve Meali Card -->
                        <Border x:Name="KuranMealFrame"
                                StrokeShape="RoundRectangle 20"
                                Padding="18,16"
                                Stroke="{AppThemeBinding Light=#3000796B, Dark=#25FFFFFF}"
                                BackgroundColor="{AppThemeBinding Light=#55FFFFFF, Dark=#331E293B}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="KuranMealButton_Clicked"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <!-- Gradient Icon Circle -->
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 16"
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        VerticalOptions="Center"
                                        Stroke="Transparent">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#009688" Offset="0.0"/>
                                            <GradientStop Color="#00796B" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Label Text="📗" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="Kur'an-ı Kerim ve Meali"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1B2E2B, Dark=#FFFFFF}"/>
                                    <Label Text="Sureler, Türkçe mealler, ayet arama ve yer işaretleri"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#666666, Dark=#B0BEC5}"/>
                                    
                                    <!-- Badge Chip -->
                                    <Border HorizontalOptions="Start"
                                            Margin="0,2,0,0"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="8,3"
                                            Stroke="Transparent"
                                            BackgroundColor="{AppThemeBinding Light=#E0F2F1, Dark=#1A004D40}">
                                        <Label Text="Türkçe Meal &amp; Okuma"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#00796B, Dark=#80CBC4}"/>
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Chevron Arrow -->
                                <Border Grid.Column="2"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        StrokeShape="RoundRectangle 16"
                                        VerticalOptions="Center"
                                        Stroke="Transparent"
                                        BackgroundColor="{AppThemeBinding Light=#1500796B, Dark=#20FFFFFF}">
                                    <Image Source="gerigit.svg"
                                           Rotation="180"
                                           HeightRequest="16"
                                           WidthRequest="16"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Arapça Kur'an Card -->
                        <Border x:Name="ArapcaKuranFrame"
                                StrokeShape="RoundRectangle 20"
                                Padding="18,16"
                                Stroke="{AppThemeBinding Light=#3000796B, Dark=#25FFFFFF}"
                                BackgroundColor="{AppThemeBinding Light=#55FFFFFF, Dark=#331E293B}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ArapcaKuranButton_Clicked"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <!-- Gradient Icon Circle -->
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 16"
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        VerticalOptions="Center"
                                        Stroke="Transparent">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#00796B" Offset="0.0"/>
                                            <GradientStop Color="#004D40" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Label Text="📖" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="Arapça Kur'an-ı Kerim"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1B2E2B, Dark=#FFFFFF}"/>
                                    <Label Text="Orijinal Medine mushafı sayfaları ve dahili meal paneli"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#666666, Dark=#B0BEC5}"/>
                                    
                                    <!-- Badge Chip -->
                                    <Border HorizontalOptions="Start"
                                            Margin="0,2,0,0"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="8,3"
                                            Stroke="Transparent"
                                            BackgroundColor="{AppThemeBinding Light=#E0F2F1, Dark=#1A004D40}">
                                        <Label Text="Orijinal Mushaf Görünümü"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#00796B, Dark=#80CBC4}"/>
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Chevron Arrow -->
                                <Border Grid.Column="2"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        StrokeShape="RoundRectangle 16"
                                        VerticalOptions="Center"
                                        Stroke="Transparent"
                                        BackgroundColor="{AppThemeBinding Light=#1500796B, Dark=#20FFFFFF}">
                                    <Image Source="gerigit.svg"
                                           Rotation="180"
                                           HeightRequest="16"
                                           WidthRequest="16"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- BÖLÜM 2: İBADET & İLMİHAL KILAVUZLARI -->
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto, *" Margin="4,0,0,0">
                            <Label Text="🕌" FontSize="16" VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="İBADET &amp; İLMİHAL KILAVUZLARI"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="{AppThemeBinding Light=#00796B, Dark=#80CBC4}"
                                   Margin="8,0,0,0"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- İlmihal Bilgileri Card -->
                        <Border x:Name="IlmihalFrame"
                                StrokeShape="RoundRectangle 20"
                                Padding="18,16"
                                Stroke="{AppThemeBinding Light=#3000796B, Dark=#25FFFFFF}"
                                BackgroundColor="{AppThemeBinding Light=#55FFFFFF, Dark=#331E293B}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="IlmihalButton_Clicked"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <!-- Gradient Icon Circle -->
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 16"
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        VerticalOptions="Center"
                                        Stroke="Transparent">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0288D1" Offset="0.0"/>
                                            <GradientStop Color="#01579B" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Label Text="📚" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="İlmihal Rehberi"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1B2E2B, Dark=#FFFFFF}"/>
                                    <Label Text="Temel dini bilgiler, abdest, gusül ve namaz hükümleri"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#666666, Dark=#B0BEC5}"/>
                                    
                                    <!-- Badge Chip -->
                                    <Border HorizontalOptions="Start"
                                            Margin="0,2,0,0"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="8,3"
                                            Stroke="Transparent"
                                            BackgroundColor="{AppThemeBinding Light=#E1F5FE, Dark=#1A01579B}">
                                        <Label Text="Temel Dini Bilgiler"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#0288D1, Dark=#81D4FA}"/>
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Chevron Arrow -->
                                <Border Grid.Column="2"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        StrokeShape="RoundRectangle 16"
                                        VerticalOptions="Center"
                                        Stroke="Transparent"
                                        BackgroundColor="{AppThemeBinding Light=#1500796B, Dark=#20FFFFFF}">
                                    <Image Source="gerigit.svg"
                                           Rotation="180"
                                           HeightRequest="16"
                                           WidthRequest="16"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Namaz Hocası Card -->
                        <Border x:Name="NamazHocasiFrame"
                                StrokeShape="RoundRectangle 20"
                                Padding="18,16"
                                Stroke="{AppThemeBinding Light=#3000796B, Dark=#25FFFFFF}"
                                BackgroundColor="{AppThemeBinding Light=#55FFFFFF, Dark=#331E293B}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NamazHocasiButton_Clicked"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <!-- Gradient Icon Circle -->
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 16"
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        VerticalOptions="Center"
                                        Stroke="Transparent">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#7B1FA2" Offset="0.0"/>
                                            <GradientStop Color="#4A148C" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Label Text="🛐" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="Namaz Hocası"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1B2E2B, Dark=#FFFFFF}"/>
                                    <Label Text="Adım adım anlatımlı namaz kılma kılavuzu"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#666666, Dark=#B0BEC5}"/>

                                    <!-- Badge Chip -->
                                    <Border HorizontalOptions="Start"
                                            Margin="0,2,0,0"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="8,3"
                                            Stroke="Transparent"
                                            BackgroundColor="{AppThemeBinding Light=#F3E5F5, Dark=#1A4A148C}">
                                        <Label Text="Anlatımlı Rehber"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#7B1FA2, Dark=#E1BEE7}"/>
                                    </Border>
                                </VerticalStackLayout>
                                <!-- Chevron Arrow -->
                                <Border Grid.Column="2"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        StrokeShape="RoundRectangle 16"
                                        VerticalOptions="Center"
                                        Stroke="Transparent"
                                        BackgroundColor="{AppThemeBinding Light=#1500796B, Dark=#20FFFFFF}">
                                    <Image Source="gerigit.svg"
                                           Rotation="180"
                                           HeightRequest="16"
                                           WidthRequest="16"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
        </Grid>

        <!-- Özel Yüzen TabBar -->
        <controls:CustomTabBar CurrentTab="Kutuphane" ZIndex="10" />

    </Grid>
</ContentPage>
