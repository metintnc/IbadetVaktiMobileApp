<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:hadis.Controls"
             x:Class="hadis.Kutuphane"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#020617"
             Title="Kütüphane">

    <Grid Padding="0" Margin="0">
        <!-- Dinamik Saat Bazlı Arkaplan (Ana sayfa ile senkronize) -->
        <Image x:Name="BackgroundImage"
               Aspect="AspectFill"
               Scale="1.05"
               HorizontalOptions="FillAndExpand"
               VerticalOptions="FillAndExpand">
            <Image.Source>
                <AppThemeBinding Light="bg_light.jpg" Dark="ayarlararkaplan.webp" />
            </Image.Source>
        </Image>

        <!-- Tema Arkaplan Overlay (BackgroundService tarafından yönetilir) -->
        <Grid x:Name="BackgroundOverlay"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand"
              IsVisible="False" />

        <!-- Koyu Atmosferik Gradyan Overlay -->
        <BoxView HorizontalOptions="FillAndExpand"
                 VerticalOptions="FillAndExpand"
                 InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CC020617" Offset="0.0" />
                    <GradientStop Color="#99020617" Offset="0.45" />
                    <GradientStop Color="#F2020617" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- İçerik Alanı -->
        <Grid x:Name="MainContentGrid"
              RowDefinitions="Auto, *"
              Padding="16,20,16,0">

            <!-- Sabit Başlık Kartı -->
            <Border Grid.Row="0"
                    x:Name="HeaderFrame"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="1"
                    Stroke="#26FFFFFF"
                    BackgroundColor="#12FFFFFF"
                    Padding="18,14"
                    Margin="0,0,0,12">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,8" Radius="20" Opacity="0.3" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="📖" FontSize="16" VerticalOptions="Center" />
                        <Label Text="İslami Kütüphane"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center">
                            <Label.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.4" />
                            </Label.Shadow>
                        </Label>
                    </HorizontalStackLayout>
                    <Label Text="Kur'an-ı Kerim, Mealler ve İbadet Rehberleri"
                           FontSize="12"
                           HorizontalOptions="Center"
                           TextColor="#B3FFFFFF" />
                </VerticalStackLayout>
            </Border>

            <!-- Kaydırılabilir İçerik Listesi -->
            <ScrollView Grid.Row="1"
                        VerticalScrollBarVisibility="Never"
                        HorizontalScrollBarVisibility="Never"
                        Padding="0,0,0,126">
                <VerticalStackLayout Spacing="14">

                    <!-- Arama & Filtre Çubuğu -->
                    <VerticalStackLayout Spacing="10">
                        <Border StrokeShape="RoundRectangle 14"
                                StrokeThickness="1"
                                Stroke="#26FFFFFF"
                                BackgroundColor="#800F172A"
                                Padding="12,2">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       Text="🔍"
                                       FontSize="14"
                                       TextColor="#80FFFFFF"
                                       VerticalOptions="Center" />
                                <Entry x:Name="SearchEntry"
                                       Grid.Column="1"
                                       Placeholder="Sure, ilmihal veya rehber ara..."
                                       PlaceholderColor="#66FFFFFF"
                                       TextColor="White"
                                       FontSize="13"
                                       BackgroundColor="Transparent"
                                       ClearButtonVisibility="WhileEditing"
                                       TextChanged="OnSearchTextChanged" />
                            </Grid>
                        </Border>

                        <!-- Filtre Chipleri -->
                        <ScrollView Orientation="Horizontal"
                                    HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8">
                                <Border x:Name="FilterAllBorder"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="1"
                                        Stroke="#8022D3EE"
                                        BackgroundColor="#4006B6D4"
                                        Padding="12,6">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFilterTapped" CommandParameter="All" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="FilterAllLabel"
                                           Text="Tümü"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#A5F3FC" />
                                </Border>

                                <Border x:Name="FilterQuranBorder"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="1"
                                        Stroke="#1AFFFFFF"
                                        BackgroundColor="#0FFFFFFF"
                                        Padding="12,6">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFilterTapped" CommandParameter="Quran" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="FilterQuranLabel"
                                           Text="Kur'an &amp; Meal"
                                           FontSize="12"
                                           TextColor="#CCFFFFFF" />
                                </Border>

                                <Border x:Name="FilterIlmihalBorder"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="1"
                                        Stroke="#1AFFFFFF"
                                        BackgroundColor="#0FFFFFFF"
                                        Padding="12,6">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFilterTapped" CommandParameter="Ilmihal" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="FilterIlmihalLabel"
                                           Text="İlmihal"
                                           FontSize="12"
                                           TextColor="#CCFFFFFF" />
                                </Border>

                                <Border x:Name="FilterNamazBorder"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="1"
                                        Stroke="#1AFFFFFF"
                                        BackgroundColor="#0FFFFFFF"
                                        Padding="12,6">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFilterTapped" CommandParameter="Namaz" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="FilterNamazLabel"
                                           Text="Namaz Rehberi"
                                           FontSize="12"
                                           TextColor="#CCFFFFFF" />
                                </Border>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <!-- BÖLÜM 1: KUR'AN-I KERİM & MEALLER -->
                    <VerticalStackLayout x:Name="QuranSection" Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,4,4,0">
                            <Label Grid.Column="0" Text="📖" FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="KUR'AN-I KERİM &amp; MEALLER"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="#22D3EE"
                                   Margin="8,0,0,0"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2"
                                   Text="2 Kaynak"
                                   FontSize="11"
                                   TextColor="#66FFFFFF"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Kur'an-ı Kerim ve Meali Card -->
                        <Border x:Name="KuranMealFrame"
                                StrokeShape="RoundRectangle 18"
                                StrokeThickness="1"
                                Stroke="#26FFFFFF"
                                BackgroundColor="#12FFFFFF"
                                Padding="14">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,8" Radius="20" Opacity="0.3" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="KuranMealButton_Clicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 16"
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        VerticalOptions="Center"
                                        StrokeThickness="1"
                                        Stroke="#4D6EE7B7">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#CC10B981" Offset="0.0" />
                                            <GradientStop Color="#E60F766E" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Label Text="📗" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="Kur'an-ı Kerim ve Meali"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                    <Label Text="Sureler, Türkçe mealler, ayet arama ve yer işaretleri"
                                           FontSize="11"
                                           TextColor="#B3FFFFFF"
                                           LineBreakMode="TailTruncation" />
                                    <HorizontalStackLayout Spacing="8" Margin="0,3,0,0" VerticalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 7"
                                                Padding="8,3"
                                                StrokeThickness="1"
                                                Stroke="#4022D3EE"
                                                BackgroundColor="#2606B6D4">
                                            <Label Text="Türkçe Meal &amp; Okuma"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="#67E8F9" />
                                        </Border>
                                        <Label Text="114 Sure"
                                               FontSize="10"
                                               TextColor="#66FFFFFF"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#4DFFFFFF"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Arapça Kur'an Card -->
                        <Border x:Name="ArapcaKuranFrame"
                                StrokeShape="RoundRectangle 18"
                                StrokeThickness="1"
                                Stroke="#26FFFFFF"
                                BackgroundColor="#12FFFFFF"
                                Padding="14">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,8" Radius="20" Opacity="0.3" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ArapcaKuranButton_Clicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 16"
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        VerticalOptions="Center"
                                        StrokeThickness="1"
                                        Stroke="#4D67E8F9">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#CC14B8A6" Offset="0.0" />
                                            <GradientStop Color="#E6155E75" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Label Text="📖" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="Arapça Kur'an-ı Kerim"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                    <Label Text="Orijinal Medine mushafı sayfaları ve dahili meal paneli"
                                           FontSize="11"
                                           TextColor="#B3FFFFFF"
                                           LineBreakMode="TailTruncation" />
                                    <HorizontalStackLayout Spacing="8" Margin="0,3,0,0" VerticalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 7"
                                                Padding="8,3"
                                                StrokeThickness="1"
                                                Stroke="#4034D399"
                                                BackgroundColor="#2610B981">
                                            <Label Text="Orijinal Mushaf Görünümü"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="#6EE7B7" />
                                        </Border>
                                        <Label Text="604 Sayfa"
                                               FontSize="10"
                                               TextColor="#66FFFFFF"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#4DFFFFFF"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- BÖLÜM 2: İBADET & İLMİHAL KILAVUZLARI -->
                    <VerticalStackLayout x:Name="GuidesSection" Spacing="10" Margin="0,4,0,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,0,4,0">
                            <Label Grid.Column="0" Text="🕌" FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="İBADET &amp; İLMİHAL KILAVUZLARI"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="#67E8F9"
                                   Margin="8,0,0,0"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2"
                                   Text="2 Rehber"
                                   FontSize="11"
                                   TextColor="#66FFFFFF"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- İlmihal Rehberi Card -->
                        <Border x:Name="IlmihalFrame"
                                StrokeShape="RoundRectangle 18"
                                StrokeThickness="1"
                                Stroke="#26FFFFFF"
                                BackgroundColor="#12FFFFFF"
                                Padding="14">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,8" Radius="20" Opacity="0.3" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="IlmihalButton_Clicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 16"
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        VerticalOptions="Center"
                                        StrokeThickness="1"
                                        Stroke="#4D60A5FA">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#CC2563EB" Offset="0.0" />
                                            <GradientStop Color="#E63730A3" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Label Text="📚" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="İlmihal Rehberi"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                    <Label Text="Temel dini bilgiler, abdest, gusül ve namaz hükümleri"
                                           FontSize="11"
                                           TextColor="#B3FFFFFF"
                                           LineBreakMode="TailTruncation" />
                                    <HorizontalStackLayout Spacing="8" Margin="0,3,0,0" VerticalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 7"
                                                Padding="8,3"
                                                StrokeThickness="1"
                                                Stroke="#4060A5FA"
                                                BackgroundColor="#263B82F6">
                                            <Label Text="Temel Dini Bilgiler"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="#93C5FD" />
                                        </Border>
                                        <Label Text="Diyanet Uyumlu"
                                               FontSize="10"
                                               TextColor="#66FFFFFF"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#4DFFFFFF"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Namaz Hocası Card -->
                        <Border x:Name="NamazHocasiFrame"
                                StrokeShape="RoundRectangle 18"
                                StrokeThickness="1"
                                Stroke="#26FFFFFF"
                                BackgroundColor="#12FFFFFF"
                                Padding="14">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,8" Radius="20" Opacity="0.3" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NamazHocasiButton_Clicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 16"
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        VerticalOptions="Center"
                                        StrokeThickness="1"
                                        Stroke="#4DC084FC">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#CC7C3AED" Offset="0.0" />
                                            <GradientStop Color="#E6581C87" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Label Text="🤲" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="Namaz Hocası"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                    <Label Text="Adım adım görsel anlatımlı namaz kılma kılavuzu ve dualar"
                                           FontSize="11"
                                           TextColor="#B3FFFFFF"
                                           LineBreakMode="TailTruncation" />
                                    <HorizontalStackLayout Spacing="8" Margin="0,3,0,0" VerticalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 7"
                                                Padding="8,3"
                                                StrokeThickness="1"
                                                Stroke="#40A78BFA"
                                                BackgroundColor="#268B5CF6">
                                            <Label Text="Görsel &amp; Anlatımlı Rehber"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="#C4B5FD" />
                                        </Border>
                                        <Label Text="Tüm Vakitler"
                                               FontSize="10"
                                               TextColor="#66FFFFFF"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#4DFFFFFF"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Arama Sonucu Boş Durumu -->
                    <Label x:Name="EmptySearchLabel"
                           Text="Aramanızla eşleşen içerik bulunamadı."
                           FontSize="13"
                           TextColor="#80FFFFFF"
                           HorizontalOptions="Center"
                           Margin="0,24,0,0"
                           IsVisible="False" />

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Özel Yüzen TabBar -->
        <controls:CustomTabBar CurrentTab="Kutuphane" ZIndex="10" />

    </Grid>
</ContentPage>
