<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:hadis.ViewModels"
             x:Class="hadis.MainPage" 
             x:DataType="vm:MainPageViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Transparent">

    <Grid Padding="0" Margin="0">
        <!-- Arkaplan Resmi - En altta -->
        <Image x:Name="BackgroundImage"
               Aspect="AspectFill"
               HorizontalOptions="FillAndExpand"
               VerticalOptions="FillAndExpand">
            <Image.Source>
                <AppThemeBinding Light="kuran_light.webp" Dark="kuranarkaplan.webp" />
            </Image.Source>
        </Image>
        <!-- Arkaplan Overlay - Ortada -->
        <Grid x:Name="BackgroundOverlay"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand"
              IsVisible="False" />

        <!-- İnternet Hatası Uyarısı (En Üstte) -->
        <Grid x:Name="InternetErrorOverlay"
              BackgroundColor="{AppThemeBinding Light=#DDFFFFFF, Dark=#DD000000}"
              IsVisible="{Binding IsInternetErrorVisible}"
              ZIndex="999"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand">
            <VerticalStackLayout Spacing="20" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="{Binding ErrorTitle}"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}"/>
                <Label Text="{Binding ErrorDescription}"
                       FontSize="16"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#616161, Dark=#BDBDBD}"
                       Padding="40,0"/>
                <ActivityIndicator IsRunning="True" 
                                   Color="{AppThemeBinding Light=#00796B, Dark=#009688}"
                                   HorizontalOptions="Center"/>
                <Label Text="Bağlantı bekleniyor..."
                       FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=#00796B, Dark=#80CBC4}"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Konum Hatası Uyarısı (İnternet Uyarısı ile aynı seviyede) -->
        <Grid x:Name="LocationErrorOverlay"
              BackgroundColor="{AppThemeBinding Light=#DDFFFFFF, Dark=#DD000000}"
              IsVisible="{Binding IsLocationErrorVisible}"
              ZIndex="999"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand">
            <VerticalStackLayout Spacing="20" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="📍"
                       FontSize="60"
                       HorizontalOptions="Center"/>
                <Label Text="Konum Seçimi Gerekli"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=#00796B, Dark=#80CBC4}"/>
                <Label Text="Namaz vakitlerini hesaplayabilmek için bir şehir seçmelisiniz veya konum izni vermelisiniz."
                       FontSize="16"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#616161, Dark=#BDBDBD}"
                       Padding="40,0"/>
                
                <Button Text="Şehir Seç / Konum İzni"
                        BackgroundColor="{AppThemeBinding Light=#00796B, Dark=#009688}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="20"
                        Padding="30,15"
                        Clicked="OnLocationErrorRetry_Clicked"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Sayfa (Konum) Nokta Göstergesi -->
        <HorizontalStackLayout x:Name="PageIndicator"
                               HorizontalOptions="Center"
                               VerticalOptions="End"
                               Margin="0, 0, 0, 20"
                               HeightRequest="15"
                               Spacing="6"
                               IsVisible="False"
                               ZIndex="50">
            <!-- Kod tarafından Ellipse (noktalar) eklenecek -->
        </HorizontalStackLayout>

        <!-- İçerik - En üstte -->
        <Grid x:Name="MainContentGrid"
              RowDefinitions="Auto,Auto,Auto,*,Auto" 
              ColumnDefinitions="*" 
              Padding="20,20,20,20" 
              Margin="0,0,0,0"
              BackgroundColor="Transparent">

            <Grid.GestureRecognizers>
                <SwipeGestureRecognizer Direction="Right" Swiped="OnPrayerFramesSwiped" />
                <SwipeGestureRecognizer Direction="Left" Swiped="OnPrayerFramesSwiped" />
            </Grid.GestureRecognizers>

            <!-- Ana Geri Sayım Frame -->
            <StackLayout Grid.Row="0" Spacing="10">
                <Border x:Name="MainCountdownFrame" 
                       Style="{StaticResource BorderFrameStyle}" 
                       Padding="20" 
                       StrokeShape="RoundRectangle 15" 
                       Opacity="0.95"
                       Stroke="#FFFFFF">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#60FFFFFF" Offset="0.0" />
                            <GradientStop Color="#50FFFFFF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Style="{StaticResource AnaLabel}" x:Name="namazismi" Text="{Binding NamazIsmi}" HorizontalOptions="Center" FontSize="25">
                            <Label.Shadow>
                                <Shadow Brush="Black" Offset="1,1" Radius="2" Opacity="0.5" />
                            </Label.Shadow>
                        </Label>
                        <Label Style="{StaticResource AnaLabel}" x:Name="kalan" Text="{Binding KalanSure}" HorizontalOptions="Center" FontSize="45">
                            <Label.Shadow>
                                <Shadow Brush="Black" Offset="1,1" Radius="2" Opacity="0.5" />
                            </Label.Shadow>
                        </Label>
                        <Label Style="{StaticResource AnaLabel}" Text="Kaldı" TextColor="White" HorizontalOptions="Center">
                            <Label.Shadow>
                                <Shadow Brush="Black" Offset="1,1" Radius="2" Opacity="0.5" />
                            </Label.Shadow>
                        </Label>
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4" HorizontalOptions="Center">
                                <Label Grid.Column="0"
                                       Style="{StaticResource AnaLabel}"
                                       x:Name="Konum"
                                       Text="{Binding KonumText}"
                                       HorizontalOptions="Center"
                                       FontSize="10">
                                    <Label.Shadow>
                                        <Shadow Brush="Black" Offset="1,1" Radius="1" Opacity="0.4" />
                                    </Label.Shadow>
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="Konum_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>

                                <ActivityIndicator Grid.Column="1"
                                                   IsRunning="{Binding IsLocationRefreshing}"
                                                   IsVisible="{Binding IsLocationRefreshing}"
                                                   Color="White"
                                                   WidthRequest="10"
                                                   HeightRequest="10"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                            </Grid>

                            <Label Text="{Binding LocationStatusText}"
                                   IsVisible="{Binding LocationStatusText, Converter={StaticResource StringNotNullOrEmptyConverter}}"
                                   FontSize="9"
                                   TextColor="#FFD54F"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <Label Style="{StaticResource AnaLabel}" Text="{Binding HicriTarih}" HorizontalOptions="Center" FontSize="13" Margin="0,5,0,0">
                            <Label.Shadow>
                                <Shadow Brush="Black" Offset="1,1" Radius="1" Opacity="0.4" />
                            </Label.Shadow>
                        </Label>
                    </StackLayout>
                </Border>
            </StackLayout>

            <!-- İlk Satır Namaz Vakitleri -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" RowSpacing="30" ColumnSpacing="10" Margin="0,20,0,0" >

                <Border Grid.Column="0"
                        x:Name="ImsakFrame" 
                        Style="{StaticResource BorderFrameStyle}" 
                        StrokeShape="RoundRectangle 20" 
                        Padding="10"
                        Stroke="#CCFFFFFF">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#60FFFFFF" Offset="0.0" />
                            <GradientStop Color="#50FFFFFF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Style="{StaticResource AnaLabel}" x:Name="imsakyazı" Text="İmsak" HorizontalOptions="Center" FontSize="16" HorizontalTextAlignment="Center">
                            <Label.Shadow>
                                <Shadow Brush="Black" Offset="1,1" Radius="1" Opacity="0.4" />
                            </Label.Shadow>
                        </Label>
                        <Label Style="{StaticResource AnaLabel}" x:Name="imsakvakit" Text="{Binding ImsakVakit}" TextColor="{Binding ImsakVakitColor}" HorizontalOptions="Center" HorizontalTextAlignment="Center">
                            <Label.Shadow>
                                <Shadow Brush="Black" Offset="1,1" Radius="1" Opacity="0.4" />
                            </Label.Shadow>
                        </Label>
                    </StackLayout>
                </Border>

                <Border Grid.Column="1"
                        x:Name="GunesFrame" 
                        Style="{StaticResource BorderFrameStyle}" 
                        StrokeShape="RoundRectangle 20" 
                        Padding="10"
                        Stroke="#CCFFFFFF">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#60FFFFFF" Offset="0.0" />
                            <GradientStop Color="#50FFFFFF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Style="{StaticResource AnaLabel}" x:Name="gunesyazı" Text="Güneş" HorizontalOptions="Center" FontSize="16" HorizontalTextAlignment="Center">
                            <Label.Shadow>
                                <Shadow Brush="Black" Offset="1,1" Radius="1" Opacity="0.4" />
                            </Label.Shadow>
                        </Label>
                        <Label Style="{StaticResource AnaLabel}" x:Name="gunesvakit" Text="{Binding GunesVakit}" TextColor="{Binding GunesVakitColor}" HorizontalOptions="Center" HorizontalTextAlignment="Center">
                            <Label.Shadow>
                                <Shadow Brush="Black" Offset="1,1" Radius="1" Opacity="0.4" />
                            </Label.Shadow>
                        </Label>
                    </StackLayout>
                </Border>

                <Border Grid.Column="2"
                        x:Name="OgleFrame" 
                        Style="{StaticResource BorderFrameStyle}" 
                        StrokeShape="RoundRectangle 20" 
                        Padding="10"
                        Stroke="#CCFFFFFF">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#60FFFFFF" Offset="0.0" />
                            <GradientStop Color="#50FFFFFF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Style="{StaticResource AnaLabel}" x:Name="ogleyazı" Text="Öğle" HorizontalOptions="Center" FontSize="16" HorizontalTextAlignment="Center">
                            <Label.Shadow>
                                <Shadow Brush="Black" Offset="1,1" Radius="1" Opacity="0.4" />
                            </Label.Shadow>
                        </Label>
                        <Label Style="{StaticResource AnaLabel}" x:Name="oglevakit" Text="{Binding OgleVakit}" TextColor="{Binding OgleVakitColor}" HorizontalOptions="Center" HorizontalTextAlignment="Center">
                            <Label.Shadow>
                                <Shadow Brush="Black" Offset="1,1" Radius="1" Opacity="0.4" />
                            </Label.Shadow>
                        </Label>
                    </StackLayout>
                </Border>
            </Grid>

            <!-- İkinci Satır Namaz Vakitleri -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*,*" RowSpacing="30" ColumnSpacing="10" Margin="0,10,0,0" >
                <Border Grid.Column="0"
                        x:Name="IkindiFrame" 
                        Style="{StaticResource BorderFrameStyle}" 
                        StrokeShape="RoundRectangle 20" 
                        Padding="10"
                        Stroke="#CCFFFFFF">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#60FFFFFF" Offset="0.0" />
                            <GradientStop Color="#50FFFFFF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Style="{StaticResource AnaLabel}" x:Name="ikindiyazı" Text="İkindi" HorizontalOptions="Center" FontSize="16" HorizontalTextAlignment="Center">
                            <Label.Shadow>
                                <Shadow Brush="Black" Offset="1,1" Radius="1" Opacity="0.4" />
                            </Label.Shadow>
                        </Label>
                        <Label Style="{StaticResource AnaLabel}" x:Name="ikindivakit" Text="{Binding IkindiVakit}" TextColor="{Binding IkindiVakitColor}" HorizontalOptions="Center" HorizontalTextAlignment="Center">
                            <Label.Shadow>
                                <Shadow Brush="Black" Offset="1,1" Radius="1" Opacity="0.4" />
                            </Label.Shadow>
                        </Label>
                    </StackLayout>
                </Border>

                <Border Grid.Column="1"
                        x:Name="AksamFrame" 
                        Style="{StaticResource BorderFrameStyle}" 
                        StrokeShape="RoundRectangle 20" 
                        Padding="10"
                        Stroke="#CCFFFFFF">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#60FFFFFF" Offset="0.0" />
                            <GradientStop Color="#50FFFFFF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Style="{StaticResource AnaLabel}" x:Name="aksamyazı" Text="Akşam" HorizontalOptions="Center" FontSize="17" HorizontalTextAlignment="Center">
                            <Label.Shadow>
                                <Shadow Brush="Black" Offset="1,1" Radius="1" Opacity="0.4" />
                            </Label.Shadow>
                        </Label>
                        <Label Style="{StaticResource AnaLabel}" x:Name="aksamvakit" Text="{Binding AksamVakit}" TextColor="{Binding AksamVakitColor}" HorizontalOptions="Center" HorizontalTextAlignment="Center">
                            <Label.Shadow>
                                <Shadow Brush="Black" Offset="1,1" Radius="1" Opacity="0.4" />
                            </Label.Shadow>
                        </Label>
                    </StackLayout>
                </Border>

                <Border Grid.Column="2"
                        x:Name="YatsiFrame" 
                        Style="{StaticResource BorderFrameStyle}" 
                        StrokeShape="RoundRectangle 20" 
                        Padding="10"
                        Stroke="#CCFFFFFF">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#60FFFFFF" Offset="0.0" />
                            <GradientStop Color="#50FFFFFF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Style="{StaticResource AnaLabel}" x:Name="yatsıyazı" Text="Yatsı" HorizontalOptions="Center" FontSize="17" HorizontalTextAlignment="Center">
                            <Label.Shadow>
                                <Shadow Brush="Black" Offset="1,1" Radius="1" Opacity="0.4" />
                            </Label.Shadow>
                        </Label>
                        <Label Style="{StaticResource AnaLabel}" x:Name="yatsıvakit" Text="{Binding YatsiVakit}" TextColor="{Binding YatsiVakitColor}" HorizontalOptions="Center" HorizontalTextAlignment="Center">
                            <Label.Shadow>
                                <Shadow Brush="Black" Offset="1,1" Radius="1" Opacity="0.4" />
                            </Label.Shadow>
                        </Label>
                    </StackLayout>
                </Border>
            </Grid>
            
            <!-- Boşluk - Grid.Row="3" * ile esnek alan -->
            
            <!-- Ayet Frame - En Altta -->
            <Border Grid.Row="4" 
                   x:Name="AyetFrame" 
                   VerticalOptions="End" 
                   Style="{StaticResource AyetBorderStyle}"
                   Padding="15"
                   Margin="0,0,0,10"
                   StrokeShape="RoundRectangle 20"
                   Stroke="#80FFFFFF">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="AyetFrame_Tapped" />
                </Border.GestureRecognizers>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#30FFFFFF" Offset="0.0" />
                        <GradientStop Color="#20FFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                    <Label x:Name="gununayeti" Text="{Binding GununAyeti}" Style="{StaticResource AnaLabel}" LineBreakMode="WordWrap">
                        <Label.Shadow>
                            <Shadow Brush="Black" Offset="1,1" Radius="2" Opacity="0.4" />
                        </Label.Shadow>
                    </Label>
                </StackLayout>
            </Border>

        </Grid>

        <!-- Blur Overlay - Menü açıldığında arkaplanı karartır -->
        <BoxView x:Name="BlurOverlay"
                 BackgroundColor="Black"
                 Opacity="0"
                 IsVisible="False"
                 HorizontalOptions="FillAndExpand"
                 VerticalOptions="FillAndExpand"
                 ZIndex="100">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="BlurOverlay_Tapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Swipe-Up Menü Paneli -->
        <Grid x:Name="MenuPanel"
              VerticalOptions="End"
              HorizontalOptions="FillAndExpand"
              HeightRequest="340"
              TranslationY="400"
              ZIndex="200"
              Padding="0">

            <Grid.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="MenuPanel_PanUpdated" />
            </Grid.GestureRecognizers>

            <!-- Panel Arkaplanı - Glassmorphism -->
            <Border StrokeShape="RoundRectangle 28,28,0,0"
                    Stroke="#40FFFFFF"
                    StrokeThickness="1"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E8111111" Offset="0.0" />
                        <GradientStop Color="#F5080808" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <VerticalStackLayout Spacing="20" Padding="24,8,24,30">
                <!-- Grip Bar -->
                <BoxView HeightRequest="4"
                         WidthRequest="40"
                         CornerRadius="2"
                         BackgroundColor="#60FFFFFF"
                         HorizontalOptions="Center"
                         Margin="0,8,0,4" />

                <!-- Menü Başlığı -->
                <Label Text="Menü"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Start"
                       Margin="4,0,0,0" />

                <!-- 2x2 Menü Grid -->
                <Grid ColumnDefinitions="*,*" 
                      RowDefinitions="Auto,Auto" 
                      ColumnSpacing="14" 
                      RowSpacing="14">

                    <!-- Kütüphane -->
                    <Border Grid.Row="0" Grid.Column="0"
                            StrokeShape="RoundRectangle 18"
                            Stroke="#30FFFFFF"
                            StrokeThickness="1"
                            Padding="16,20"
                            HeightRequest="100">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#35FFFFFF" Offset="0.0" />
                                <GradientStop Color="#18FFFFFF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="MenuKutuphane_Tapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                            <Image Source="kuran.svg" 
                                   HeightRequest="32" WidthRequest="32" 
                                   HorizontalOptions="Center" />
                            <Label Text="Kütüphane" 
                                   FontSize="14" 
                                   TextColor="White" 
                                   HorizontalOptions="Center"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Kıble -->
                    <Border Grid.Row="0" Grid.Column="1"
                            StrokeShape="RoundRectangle 18"
                            Stroke="#30FFFFFF"
                            StrokeThickness="1"
                            Padding="16,20"
                            HeightRequest="100">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#35FFFFFF" Offset="0.0" />
                                <GradientStop Color="#18FFFFFF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="MenuKible_Tapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                            <Image Source="kiblesekme.svg" 
                                   HeightRequest="32" WidthRequest="32" 
                                   HorizontalOptions="Center" />
                            <Label Text="Kıble" 
                                   FontSize="14" 
                                   TextColor="White" 
                                   HorizontalOptions="Center"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Zikir -->
                    <Border Grid.Row="1" Grid.Column="0"
                            StrokeShape="RoundRectangle 18"
                            Stroke="#30FFFFFF"
                            StrokeThickness="1"
                            Padding="16,20"
                            HeightRequest="100">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#35FFFFFF" Offset="0.0" />
                                <GradientStop Color="#18FFFFFF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="MenuZikir_Tapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                            <Image Source="zikirmatik.svg" 
                                   HeightRequest="32" WidthRequest="32" 
                                   HorizontalOptions="Center" />
                            <Label Text="Zikir" 
                                   FontSize="14" 
                                   TextColor="White" 
                                   HorizontalOptions="Center"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Ayarlar -->
                    <Border Grid.Row="1" Grid.Column="1"
                            StrokeShape="RoundRectangle 18"
                            Stroke="#30FFFFFF"
                            StrokeThickness="1"
                            Padding="16,20"
                            HeightRequest="100">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#35FFFFFF" Offset="0.0" />
                                <GradientStop Color="#18FFFFFF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="MenuAyarlar_Tapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                            <Image Source="ayarlar.svg" 
                                   HeightRequest="32" WidthRequest="32" 
                                   HorizontalOptions="Center" />
                            <Label Text="Ayarlar" 
                                   FontSize="14" 
                                   TextColor="White" 
                                   HorizontalOptions="Center"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>
            </VerticalStackLayout>
        </Grid>

        <!-- Swipe-Up Tetikleyici (Sayfa Altından) -->
        <BoxView x:Name="SwipeUpTrigger"
                 BackgroundColor="Transparent"
                 HeightRequest="60"
                 VerticalOptions="End"
                 HorizontalOptions="FillAndExpand"
                 ZIndex="90">
            <BoxView.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="SwipeUpTrigger_PanUpdated" />
            </BoxView.GestureRecognizers>
        </BoxView>

    </Grid>
</ContentPage>


