<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:hadis.ViewModels"
             xmlns:controls="clr-namespace:hadis.Controls"
             x:Class="hadis.MainPage" 
             x:DataType="vm:MainPageViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Transparent">

    <Grid Padding="0" Margin="0">
        <!-- Arkaplan Resmi - En altta -->
        <Image x:Name="BackgroundImage"
               Aspect="AspectFill"
               HorizontalOptions="FillAndExpand"
               VerticalOptions="FillAndExpand">
            <Image.Source>
                <AppThemeBinding Light="kuran_light.webp" Dark="kuranarkaplan.webp" />
            </Image.Source>
        </Image>
        <!-- Arkaplan Overlay - Ortada -->
        <Grid x:Name="BackgroundOverlay"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand"
              IsVisible="False" />

        <!-- İnternet Hatası Uyarısı (En Üstte) -->
        <Grid x:Name="InternetErrorOverlay"
              BackgroundColor="{AppThemeBinding Light=#DDFFFFFF, Dark=#DD000000}"
              IsVisible="{Binding IsInternetErrorVisible}"
              ZIndex="999"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand">
            <VerticalStackLayout Spacing="20" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="{Binding ErrorTitle}"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}"/>
                <Label Text="{Binding ErrorDescription}"
                       FontSize="16"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#616161, Dark=#BDBDBD}"
                       Padding="40,0"/>
                <ActivityIndicator IsRunning="True" 
                                   Color="{AppThemeBinding Light=#00796B, Dark=#009688}"
                                   HorizontalOptions="Center"/>
                <Label Text="Bağlantı bekleniyor..."
                       FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=#00796B, Dark=#80CBC4}"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Konum Hatası Uyarısı (İnternet Uyarısı ile aynı seviyede) -->
        <Grid x:Name="LocationErrorOverlay"
              BackgroundColor="{AppThemeBinding Light=#DDFFFFFF, Dark=#DD000000}"
              IsVisible="{Binding IsLocationErrorVisible}"
              ZIndex="999"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand">
            <VerticalStackLayout Spacing="20" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="📍"
                       FontSize="60"
                       HorizontalOptions="Center"/>
                <Label Text="Konum Seçimi Gerekli"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=#00796B, Dark=#80CBC4}"/>
                <Label Text="Namaz vakitlerini hesaplayabilmek için bir şehir seçmelisiniz veya konum izni vermelisiniz."
                       FontSize="16"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#616161, Dark=#BDBDBD}"
                       Padding="40,0"/>
                
                <Button Text="Şehir Seç / Konum İzni"
                        BackgroundColor="{AppThemeBinding Light=#00796B, Dark=#009688}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="20"
                        Padding="30,15"
                        Clicked="OnLocationErrorRetry_Clicked"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Sayfa (Konum) Nokta Göstergesi -->
        <HorizontalStackLayout x:Name="PageIndicator"
                               HorizontalOptions="Center"
                               VerticalOptions="End"
                               Margin="0, 0, 0, 122"
                               HeightRequest="15"
                               Spacing="6"
                               IsVisible="False"
                               ZIndex="50">
            <!-- Kod tarafından Ellipse (noktalar) eklenecek -->
        </HorizontalStackLayout>

        <!-- İçerik - En üstte -->
        <Grid x:Name="MainContentGrid"
              RowDefinitions="Auto,Auto,*,Auto"
              ColumnDefinitions="*"
              RowSpacing="14"
              Padding="20,18,20,128"
              Margin="0"
              BackgroundColor="Transparent">

            <Grid.GestureRecognizers>
                <SwipeGestureRecognizer Direction="Right" Swiped="OnPrayerFramesSwiped" />
                <SwipeGestureRecognizer Direction="Left" Swiped="OnPrayerFramesSwiped" />
            </Grid.GestureRecognizers>

            <!-- Ana Geri Sayım Kartı (HeroCountdownCard) -->
            <Border Grid.Row="0"
                    x:Name="MainCountdownFrame"
                    Style="{StaticResource BorderFrameStyle}"
                    Padding="20,22"
                    StrokeShape="RoundRectangle 24"
                    StrokeThickness="1"
                    Stroke="#59FFFFFF">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#29FFFFFF" Offset="0.0" />
                        <GradientStop Color="#1FFFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#0F172A" Offset="0,8" Radius="24" Opacity="0.25" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <!-- Sıradaki Vakit Başlığı -->
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <Ellipse WidthRequest="8"
                                 HeightRequest="8"
                                 Fill="#67E8F9"
                                 VerticalOptions="Center" />
                        <Label Style="{StaticResource AnaLabel}"
                               x:Name="namazismi"
                               Text="{Binding NamazIsmi}"
                               TextColor="White"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontSize="22">
                            <Label.Shadow>
                                <Shadow Brush="Black" Offset="0,1" Radius="3" Opacity="0.35" />
                            </Label.Shadow>
                        </Label>
                    </HorizontalStackLayout>

                    <!-- Büyük Dijital Sayaç -->
                    <Label Style="{StaticResource AnaLabel}"
                           x:Name="kalan"
                           Text="{Binding KalanSure}"
                           TextColor="White"
                           FontAttributes="Bold"
                           CharacterSpacing="1"
                           HorizontalOptions="Center"
                           FontSize="44">
                        <Label.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.35" />
                        </Label.Shadow>
                    </Label>

                    <!-- Kaldı Alt Etiketi -->
                    <Label Style="{StaticResource AnaLabel}"
                           Text="KALDI"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="13"
                           CharacterSpacing="1.2"
                           HorizontalOptions="Center">
                        <Label.Shadow>
                            <Shadow Brush="Black" Offset="0,1" Radius="2" Opacity="0.35" />
                        </Label.Shadow>
                    </Label>

                    <!-- Konum Pill Rozeti -->
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center" Margin="0,8,0,0">
                        <Border StrokeShape="RoundRectangle 20"
                                StrokeThickness="1"
                                Stroke="#66FFFFFF"
                                BackgroundColor="#990F172A"
                                Padding="14,6"
                                HorizontalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Konum_Tapped" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                <Path Data="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                      Stroke="#67E8F9"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Aspect="Uniform"
                                      WidthRequest="13"
                                      HeightRequest="13"
                                      VerticalOptions="Center" />
                                <Label Style="{StaticResource AnaLabel}"
                                       x:Name="Konum"
                                       Text="{Binding KonumText}"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       FontSize="12">
                                    <Label.Shadow>
                                        <Shadow Brush="Black" Offset="0,1" Radius="2" Opacity="0.35" />
                                    </Label.Shadow>
                                </Label>
                                <ActivityIndicator IsRunning="{Binding IsLocationRefreshing}"
                                                   IsVisible="{Binding IsLocationRefreshing}"
                                                   Color="#67E8F9"
                                                   WidthRequest="12"
                                                   HeightRequest="12"
                                                   VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Label Text="{Binding LocationStatusText}"
                               IsVisible="{Binding LocationStatusText, Converter={StaticResource StringNotNullOrEmptyConverter}}"
                               FontSize="10"
                               TextColor="#FFD54F"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Hicri Tarih -->
                    <Label Style="{StaticResource AnaLabel}"
                           Text="{Binding HicriTarih}"
                           TextColor="#CCFFFFFF"
                           HorizontalOptions="Center"
                           FontSize="12"
                           Margin="0,2,0,0">
                        <Label.Shadow>
                            <Shadow Brush="Black" Offset="0,1" Radius="2" Opacity="0.35" />
                        </Label.Shadow>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- Namaz Vakitleri 3x2 Izgara (PrayerTimesGrid) -->
            <Grid Grid.Row="1"
                  RowDefinitions="Auto,Auto"
                  ColumnDefinitions="*,*,*"
                  RowSpacing="10"
                  ColumnSpacing="10"
                  Margin="0,2,0,0">

                <!-- 1. İmsak -->
                <Border Grid.Row="0" Grid.Column="0"
                        x:Name="ImsakFrame"
                        Style="{StaticResource BorderFrameStyle}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Padding="10,12"
                        Stroke="#40FFFFFF">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1FFFFFFF" Offset="0.0" />
                            <GradientStop Color="#19FFFFFF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Ellipse x:Name="ImsakDot"
                                 WidthRequest="9" HeightRequest="9"
                                 Fill="#67E8F9"
                                 Stroke="#0F172A" StrokeThickness="1.5"
                                 HorizontalOptions="End" VerticalOptions="Start"
                                 Margin="0,-4,-2,0"
                                 IsVisible="False" />
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Style="{StaticResource AnaLabel}" x:Name="imsakyazı" Text="İmsak" FontAttributes="Bold" HorizontalOptions="Center" FontSize="13" HorizontalTextAlignment="Center">
                                <Label.Shadow>
                                    <Shadow Brush="Black" Offset="0,1" Radius="2" Opacity="0.35" />
                                </Label.Shadow>
                            </Label>
                            <Label Style="{StaticResource AnaLabel}" x:Name="imsakvakit" Text="{Binding ImsakVakit}" TextColor="{Binding ImsakVakitColor}" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" HorizontalTextAlignment="Center">
                                <Label.Shadow>
                                    <Shadow Brush="Black" Offset="0,1" Radius="2" Opacity="0.35" />
                                </Label.Shadow>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- 2. Güneş -->
                <Border Grid.Row="0" Grid.Column="1"
                        x:Name="GunesFrame"
                        Style="{StaticResource BorderFrameStyle}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Padding="10,12"
                        Stroke="#40FFFFFF">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1FFFFFFF" Offset="0.0" />
                            <GradientStop Color="#19FFFFFF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Ellipse x:Name="GunesDot"
                                 WidthRequest="9" HeightRequest="9"
                                 Fill="#67E8F9"
                                 Stroke="#0F172A" StrokeThickness="1.5"
                                 HorizontalOptions="End" VerticalOptions="Start"
                                 Margin="0,-4,-2,0"
                                 IsVisible="False" />
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Style="{StaticResource AnaLabel}" x:Name="gunesyazı" Text="Güneş" FontAttributes="Bold" HorizontalOptions="Center" FontSize="13" HorizontalTextAlignment="Center">
                                <Label.Shadow>
                                    <Shadow Brush="Black" Offset="0,1" Radius="2" Opacity="0.35" />
                                </Label.Shadow>
                            </Label>
                            <Label Style="{StaticResource AnaLabel}" x:Name="gunesvakit" Text="{Binding GunesVakit}" TextColor="{Binding GunesVakitColor}" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" HorizontalTextAlignment="Center">
                                <Label.Shadow>
                                    <Shadow Brush="Black" Offset="0,1" Radius="2" Opacity="0.35" />
                                </Label.Shadow>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- 3. Öğle -->
                <Border Grid.Row="0" Grid.Column="2"
                        x:Name="OgleFrame"
                        Style="{StaticResource BorderFrameStyle}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Padding="10,12"
                        Stroke="#40FFFFFF">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1FFFFFFF" Offset="0.0" />
                            <GradientStop Color="#19FFFFFF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Ellipse x:Name="OgleDot"
                                 WidthRequest="9" HeightRequest="9"
                                 Fill="#67E8F9"
                                 Stroke="#0F172A" StrokeThickness="1.5"
                                 HorizontalOptions="End" VerticalOptions="Start"
                                 Margin="0,-4,-2,0"
                                 IsVisible="False" />
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Style="{StaticResource AnaLabel}" x:Name="ogleyazı" Text="Öğle" FontAttributes="Bold" HorizontalOptions="Center" FontSize="13" HorizontalTextAlignment="Center">
                                <Label.Shadow>
                                    <Shadow Brush="Black" Offset="0,1" Radius="2" Opacity="0.35" />
                                </Label.Shadow>
                            </Label>
                            <Label Style="{StaticResource AnaLabel}" x:Name="oglevakit" Text="{Binding OgleVakit}" TextColor="{Binding OgleVakitColor}" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" HorizontalTextAlignment="Center">
                                <Label.Shadow>
                                    <Shadow Brush="Black" Offset="0,1" Radius="2" Opacity="0.35" />
                                </Label.Shadow>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- 4. İkindi -->
                <Border Grid.Row="1" Grid.Column="0"
                        x:Name="IkindiFrame"
                        Style="{StaticResource BorderFrameStyle}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Padding="10,12"
                        Stroke="#40FFFFFF">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1FFFFFFF" Offset="0.0" />
                            <GradientStop Color="#19FFFFFF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Ellipse x:Name="IkindiDot"
                                 WidthRequest="9" HeightRequest="9"
                                 Fill="#67E8F9"
                                 Stroke="#0F172A" StrokeThickness="1.5"
                                 HorizontalOptions="End" VerticalOptions="Start"
                                 Margin="0,-4,-2,0"
                                 IsVisible="False" />
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Style="{StaticResource AnaLabel}" x:Name="ikindiyazı" Text="İkindi" FontAttributes="Bold" HorizontalOptions="Center" FontSize="13" HorizontalTextAlignment="Center">
                                <Label.Shadow>
                                    <Shadow Brush="Black" Offset="0,1" Radius="2" Opacity="0.35" />
                                </Label.Shadow>
                            </Label>
                            <Label Style="{StaticResource AnaLabel}" x:Name="ikindivakit" Text="{Binding IkindiVakit}" TextColor="{Binding IkindiVakitColor}" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" HorizontalTextAlignment="Center">
                                <Label.Shadow>
                                    <Shadow Brush="Black" Offset="0,1" Radius="2" Opacity="0.35" />
                                </Label.Shadow>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- 5. Akşam -->
                <Border Grid.Row="1" Grid.Column="1"
                        x:Name="AksamFrame"
                        Style="{StaticResource BorderFrameStyle}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Padding="10,12"
                        Stroke="#40FFFFFF">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1FFFFFFF" Offset="0.0" />
                            <GradientStop Color="#19FFFFFF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Ellipse x:Name="AksamDot"
                                 WidthRequest="9" HeightRequest="9"
                                 Fill="#67E8F9"
                                 Stroke="#0F172A" StrokeThickness="1.5"
                                 HorizontalOptions="End" VerticalOptions="Start"
                                 Margin="0,-4,-2,0"
                                 IsVisible="False" />
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Style="{StaticResource AnaLabel}" x:Name="aksamyazı" Text="Akşam" FontAttributes="Bold" HorizontalOptions="Center" FontSize="13" HorizontalTextAlignment="Center">
                                <Label.Shadow>
                                    <Shadow Brush="Black" Offset="0,1" Radius="2" Opacity="0.35" />
                                </Label.Shadow>
                            </Label>
                            <Label Style="{StaticResource AnaLabel}" x:Name="aksamvakit" Text="{Binding AksamVakit}" TextColor="{Binding AksamVakitColor}" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" HorizontalTextAlignment="Center">
                                <Label.Shadow>
                                    <Shadow Brush="Black" Offset="0,1" Radius="2" Opacity="0.35" />
                                </Label.Shadow>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- 6. Yatsı -->
                <Border Grid.Row="1" Grid.Column="2"
                        x:Name="YatsiFrame"
                        Style="{StaticResource BorderFrameStyle}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Padding="10,12"
                        Stroke="#40FFFFFF">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1FFFFFFF" Offset="0.0" />
                            <GradientStop Color="#19FFFFFF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Ellipse x:Name="YatsiDot"
                                 WidthRequest="9" HeightRequest="9"
                                 Fill="#67E8F9"
                                 Stroke="#0F172A" StrokeThickness="1.5"
                                 HorizontalOptions="End" VerticalOptions="Start"
                                 Margin="0,-4,-2,0"
                                 IsVisible="False" />
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Style="{StaticResource AnaLabel}" x:Name="yatsıyazı" Text="Yatsı" FontAttributes="Bold" HorizontalOptions="Center" FontSize="13" HorizontalTextAlignment="Center">
                                <Label.Shadow>
                                    <Shadow Brush="Black" Offset="0,1" Radius="2" Opacity="0.35" />
                                </Label.Shadow>
                            </Label>
                            <Label Style="{StaticResource AnaLabel}" x:Name="yatsıvakit" Text="{Binding YatsiVakit}" TextColor="{Binding YatsiVakitColor}" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" HorizontalTextAlignment="Center">
                                <Label.Shadow>
                                    <Shadow Brush="Black" Offset="0,1" Radius="2" Opacity="0.35" />
                                </Label.Shadow>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </Grid>

            <!-- Boşluk - Grid.Row="2" * ile esnek alan -->

            <!-- Günlük Ayet Pill Kartı (DailyVerseCard) -->
            <Border Grid.Row="3"
                    x:Name="AyetFrame"
                    VerticalOptions="End"
                    Style="{StaticResource AyetBorderStyle}"
                    Padding="18,12"
                    Margin="0,0,0,6"
                    StrokeShape="RoundRectangle 26"
                    StrokeThickness="1"
                    Stroke="#40FFFFFF"
                    BackgroundColor="#730F172A">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="AyetFrame_Tapped" />
                </Border.GestureRecognizers>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="18" Opacity="0.3" />
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                    <Path Grid.Column="0"
                          Data="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"
                          Fill="#67E8F9"
                          Aspect="Uniform"
                          WidthRequest="15"
                          HeightRequest="15"
                          VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           x:Name="gununayeti"
                           Text="{Binding GununAyeti}"
                           Style="{StaticResource AnaLabel}"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="13"
                           HorizontalTextAlignment="Start"
                           VerticalOptions="Center"
                           LineBreakMode="WordWrap">
                        <Label.Shadow>
                            <Shadow Brush="Black" Offset="0,1" Radius="2" Opacity="0.35" />
                        </Label.Shadow>
                    </Label>
                </Grid>
            </Border>

        </Grid>

        <!-- Özel Yüzen TabBar -->
        <controls:CustomTabBar CurrentTab="Vakitler" ZIndex="10" />

        <!-- Alttan Kayarak Açılan Güncelleme Kartı (Bottom Sheet Overlay) -->
        <Grid x:Name="UpdateBottomSheetOverlay"
              ZIndex="1000"
              IsVisible="False"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand">
            
            <!-- Arka Plan Karartma (Backdrop) -->
            <BoxView BackgroundColor="#80000000"
                     HorizontalOptions="FillAndExpand"
                     VerticalOptions="FillAndExpand">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnUpdateBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Alttan Kayarak Açılan Kart -->
            <Border x:Name="UpdateBottomSheetCard"
                    VerticalOptions="End"
                    HorizontalOptions="FillAndExpand"
                    StrokeThickness="1"
                    Stroke="#40FFFFFF"
                    Margin="0"
                    Padding="24,20,24,32"
                    StrokeShape="RoundRectangle 24,24,0,0"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,-4" Radius="20" Opacity="0.5" />
                </Border.Shadow>
                
                <VerticalStackLayout Spacing="16">
                    <!-- Üst Tutamak Çubuğu -->
                    <BoxView WidthRequest="40"
                             HeightRequest="4"
                             CornerRadius="2"
                             BackgroundColor="{AppThemeBinding Light=#CBD5E1, Dark=#475569}"
                             HorizontalOptions="Center"
                             Margin="0,0,0,4" />

                    <!-- İkon ve Başlık -->
                    <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                        <Border StrokeShape="RoundRectangle 16"
                                WidthRequest="48"
                                HeightRequest="48"
                                BackgroundColor="#10B981"
                                StrokeThickness="0">
                            <Label Text="🚀"
                                   FontSize="24"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label x:Name="UpdateSheetTitle"
                                   Text="Yeni Güncelleme Mevcut! 🚀"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            <Label x:Name="UpdateSheetVersion"
                                   Text="Versiyon 1.1.5"
                                   FontSize="13"
                                   TextColor="#10B981"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Açıklama Metni -->
                    <Label x:Name="UpdateSheetMessage"
                           Text="Namaz Vakti uygulamasının yeni sürümü Play Store'da yayınlandı. Kesintisiz ve güncel bir deneyim için lütfen güncelleyin."
                           FontSize="14"
                           LineHeight="1.3"
                           TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" />

                    <!-- Buton Grubu -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <Button x:Name="UpdateSheetDismissButton"
                                Grid.Column="0"
                                Text="Daha Sonra"
                                Clicked="OnUpdateDismissClicked"
                                BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}"
                                CornerRadius="14"
                                HeightRequest="48"
                                FontAttributes="Bold" />

                        <Button x:Name="UpdateSheetActionButton"
                                Grid.Column="1"
                                Text="Şimdi Güncelle"
                                Clicked="OnUpdateNowClicked"
                                BackgroundColor="#10B981"
                                TextColor="White"
                                CornerRadius="14"
