<Shell
    x:Class="hadis.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:hadis"
    Title="hadis"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">
    
    <TabBar>
        <Tab Route="MainPage">
            <ShellContent x:Name="ContentVakitler" />
        </Tab>
        <Tab Route="Kutuphane">
            <ShellContent x:Name="ContentKutuphane" />
        </Tab>
        <Tab Route="kible">
            <ShellContent x:Name="ContentKible" />
        </Tab>
        <Tab Route="zikirmatik">
            <ShellContent x:Name="ContentZikirmatik" />
        </Tab>
        <Tab Route="Ayarlar">
            <ShellContent x:Name="ContentAyarlar" />
        </Tab>
    </TabBar>
</Shell>


