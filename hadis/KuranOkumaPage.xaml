<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="hadis.KuranOkumaPage"
             Title="Kur'an-ı Kerim"
             BackgroundColor="#FFF1D1">

    <Grid x:Name="MainGrid" RowDefinitions="Auto, *, Auto" RowSpacing="0">
        
        <!-- Row 0: Header (Controls) -->
        <Border Grid.Row="0"
                ZIndex="50"
                BackgroundColor="#1E1E1E"
                StrokeThickness="0"
                Padding="12, 10">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                <!-- Back Button -->
                <ImageButton Grid.Column="0"
                             Source="gerigit.svg"
                             BackgroundColor="Transparent"
                             Clicked="OnBackClicked"
                             HeightRequest="36"
                             WidthRequest="36"
                             VerticalOptions="Center"/>

                <!-- Title, Juz & Page info -->
                <VerticalStackLayout Grid.Column="1" 
                                     VerticalOptions="Center" 
                                     HorizontalOptions="Center"
                                     Spacing="2">
                    <Label x:Name="SurahNameLabel"
                           TextColor="White"
                           FontSize="17"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                    <Label x:Name="JuzLabel"
                           TextColor="#B0BEC5"
                           FontSize="13"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Action Buttons: Meal Toggle & Go to Page -->
                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                    <Border BackgroundColor="#2A2A2A"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="1"
                            Stroke="#44FFFFFF"
                            Padding="10, 6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnToggleTranslationClicked"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="📖" FontSize="14" VerticalOptions="Center"/>
                            <Label x:Name="MealToggleLabel" Text="Meal" TextColor="White" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <Border BackgroundColor="#2A2A2A"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="1"
                            Stroke="#44FFFFFF"
                            Padding="10, 6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGoToPageClicked"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="🔍" FontSize="14" VerticalOptions="Center"/>
                            <Label x:Name="PageNumberLabel" Text="Sayfa 1" TextColor="#00BCD4" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- Row 1: CarouselView Container (IsClippedToBounds so zoom doesn't cover top header) -->
        <Grid Grid.Row="1" IsClippedToBounds="True">
            <CarouselView x:Name="PageCarousel"
                          Loop="False"
                          FlowDirection="RightToLeft"
                          PositionChanged="OnPositionChanged"
                          IsSwipeEnabled="True"
                          PeekAreaInsets="0">
                <CarouselView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" 
                                       ItemSpacing="0" 
                                       SnapPointsType="MandatorySingle"
                                       SnapPointsAlignment="Center" />
                </CarouselView.ItemsLayout>
                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <Grid BackgroundColor="#FFF1D1">
                            <Image x:Name="PageImage"
                                   Aspect="AspectFit"
                                   BackgroundColor="#FFF1D1"
                                   Margin="0">
                                <Image.Source>
                                    <UriImageSource Uri="{Binding .}" CachingEnabled="True" CacheValidity="30.00:00:00" />
                                </Image.Source>
                            </Image>

                            <Grid BackgroundColor="#80000000"
                                  IsVisible="{Binding Source={x:Reference PageImage}, Path=IsLoading}"
                                  HorizontalOptions="Fill"
                                  VerticalOptions="Fill">
                                <ActivityIndicator IsRunning="{Binding Source={x:Reference PageImage}, Path=IsLoading}"
                                                   Color="#00BCD4"
                                                   HeightRequest="50"
                                                   WidthRequest="50"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
        </Grid>

        <!-- Zoom (Yakınlaştırma/Uzaklaştırma) Yüzen Paneli (Sağ Üst Köşe - Kompakt) -->
        <Border Grid.Row="1"
                ZIndex="20"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="0,8,12,0"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="1"
                Stroke="#30000000"
                BackgroundColor="#EEFFFFFF"
                Padding="2,2">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.25" />
            </Border.Shadow>
            <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
                <!-- Zoom Out (-) -->
                <Button Text="➖"
                        Clicked="OnZoomOutClicked"
                        BackgroundColor="Transparent"
                        TextColor="#00796B"
                        FontSize="11"
                        WidthRequest="30"
                        HeightRequest="30"
                        Padding="0"
                        CornerRadius="15"/>

                <!-- Zoom In (+) -->
                <Button Text="➕"
                        Clicked="OnZoomInClicked"
                        BackgroundColor="Transparent"
                        TextColor="#00796B"
                        FontSize="11"
                        WidthRequest="30"
                        HeightRequest="30"
                        Padding="0"
                        CornerRadius="15"/>
            </HorizontalStackLayout>
        </Border>

        <!-- Row 2: Synchronized Türkçe Meali Bottom Sheet Panel (Toggleable) -->
        <Border Grid.Row="2"
                x:Name="TranslationBorder"
                IsVisible="False"
                HeightRequest="320"
                StrokeThickness="1"
                Stroke="#33FFFFFF"
                BackgroundColor="#1E1E1E"
                StrokeShape="RoundRectangle 20,20,0,0"
                Padding="16, 12">
            <Grid RowDefinitions="Auto, *">
                
                <!-- Translation Title Bar & Drag Handle -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,10">
                    <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                        <Label Text="📖" FontSize="16" VerticalOptions="Center"/>
                        <Label Text="Sayfa Meali"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#00BCD4"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    
                    <BoxView Grid.Column="1" WidthRequest="36" HeightRequest="4" Color="#55FFFFFF" CornerRadius="2" HorizontalOptions="Center" VerticalOptions="Center"/>

                    <Label Grid.Column="2"
                           Text="✕ Kapat"
                           FontSize="13"
                           TextColor="#B0BEC5"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           Padding="8,4">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnToggleTranslationClicked"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- Scrollable verses list -->
                <ScrollView Grid.Row="1">
                    <Grid>
                        <VerticalStackLayout x:Name="TranslationListContainer" Spacing="14" Padding="0,4"/>
                        
                        <ActivityIndicator x:Name="TranslationLoadingIndicator"
                                           IsRunning="False"
                                           IsVisible="False"
                                           Color="#00BCD4"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           HeightRequest="40" WidthRequest="40"/>
                    </Grid>
                </ScrollView>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
