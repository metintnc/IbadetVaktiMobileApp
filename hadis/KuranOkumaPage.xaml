<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="hadis.KuranOkumaPage"
             Title="Kur'an-ı Kerim"
             BackgroundColor="Black">

    <Grid>
        <CarouselView x:Name="PageCarousel"
                      Loop="False"
                      FlowDirection="RightToLeft"
                      PositionChanged="OnPositionChanged"
                      IsSwipeEnabled="True"
                      PeekAreaInsets="0">
            <CarouselView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" 
                                   ItemSpacing="0" 
                                   SnapPointsType="MandatorySingle"
                                   SnapPointsAlignment="Center" />
            </CarouselView.ItemsLayout>
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Image x:Name="PageImage"
                               Aspect="AspectFit"
                               Source="{Binding .}"
                               BackgroundColor="White"
                               Loaded="OnPageImageLoaded">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPageTapped"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- Overlay Controls (Hidden by default, shown on tap) -->
        <Grid x:Name="OverlayGrid"
              RowDefinitions="Auto,*,Auto"
              IsVisible="False"
              InputTransparent="True"
              CascadeInputTransparent="False">
            
            <BoxView Grid.Row="0" Color="Black" Opacity="0.7" HeightRequest="80" VerticalOptions="Start"/>
            <BoxView Grid.Row="2" Color="Black" Opacity="0.7" HeightRequest="60" VerticalOptions="End"/>

            <Label x:Name="PageNumberLabel"
                   Grid.Row="2"
                   TextColor="White"
                   FontSize="18"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Text="Sayfa 1"/>
            
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="15,0">
                <ImageButton Grid.Column="0"
                             Source="gerigit.svg"
                             BackgroundColor="Transparent"
                             Clicked="OnBackClicked"
                             HeightRequest="40"
                             WidthRequest="40"
                             InputTransparent="False"/>

                <VerticalStackLayout Grid.Column="1" 
                                     VerticalOptions="Center" 
                                     HorizontalOptions="Center"
                                     Spacing="2">
                    <Label x:Name="SurahNameLabel"
                           TextColor="White"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                    <Label x:Name="JuzLabel"
                           TextColor="#DDDDDD"
                           FontSize="14"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
            
        </Grid>

        <Grid x:Name="LoadingOverlay"
              BackgroundColor="#CC000000"
              IsVisible="True"
              ZIndex="1000"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand">
            <VerticalStackLayout Spacing="14"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Padding="30">
                <ActivityIndicator x:Name="LoadingSpinner"
                                   IsRunning="True"
                                   Color="White"
                                   HorizontalOptions="Center"/>
                <Label x:Name="LoadingMessageLabel"
                       Text="Arapça Kur'an yükleniyor..."
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
                <Label x:Name="LoadingProgressLabel"
                       Text="Sayfa 1 / 604"
                       TextColor="#DADADA"
                       FontSize="13"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
                <ProgressBar x:Name="LoadingProgressBar"
                             Progress="0.0016"
                             ProgressColor="#81C784"
                             HeightRequest="4"
                             WidthRequest="220"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>

