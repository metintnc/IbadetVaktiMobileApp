<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="hadis.KuranOkumaPage"
             Title="Kur'an-ı Kerim"
             BackgroundColor="Black">

    <Grid RowDefinitions="Auto, 5.5*, 4.5*" RowSpacing="0">
        
        <!-- Row 0: Header (Controls) -->
        <Grid Grid.Row="0" BackgroundColor="Black" Padding="15, 10" ColumnDefinitions="Auto,*,Auto">
            <ImageButton Grid.Column="0"
                         Source="gerigit.svg"
                         BackgroundColor="Transparent"
                         Clicked="OnBackClicked"
                         HeightRequest="40"
                         WidthRequest="40"/>

            <VerticalStackLayout Grid.Column="1" 
                                 VerticalOptions="Center" 
                                 HorizontalOptions="Center"
                                 Spacing="2">
                <Label x:Name="SurahNameLabel"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                <Label x:Name="JuzLabel"
                       TextColor="#DDDDDD"
                       FontSize="14"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <Label Grid.Column="2"
                   Text="🔍 Git"
                   TextColor="White"
                   FontSize="16"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="End"
                   Margin="0,0,10,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGoToPageClicked"/>
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- Row 1: CarouselView for Arabic Kuran pages -->
        <CarouselView Grid.Row="1"
                      x:Name="PageCarousel"
                      Loop="False"
                      FlowDirection="RightToLeft"
                      PositionChanged="OnPositionChanged"
                      IsSwipeEnabled="True"
                      PeekAreaInsets="0">
            <CarouselView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" 
                                   ItemSpacing="0" 
                                   SnapPointsType="MandatorySingle"
                                   SnapPointsAlignment="Center" />
            </CarouselView.ItemsLayout>
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Image x:Name="PageImage"
                               Aspect="AspectFit"
                               BackgroundColor="#FEF1D1">
                            <Image.Source>
                                <UriImageSource Uri="{Binding .}" CachingEnabled="True" CacheValidity="30.00:00:00" />
                            </Image.Source>
                        </Image>

                        <Grid BackgroundColor="#CC000000"
                              IsVisible="{Binding Source={x:Reference PageImage}, Path=IsLoading}"
                              HorizontalOptions="FillAndExpand"
                              VerticalOptions="FillAndExpand">
                            <ActivityIndicator IsRunning="{Binding Source={x:Reference PageImage}, Path=IsLoading}"
                                               Color="White"
                                               HeightRequest="60"
                                               WidthRequest="60"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- Row 2: Synchronized Türkçe Meali Border -->
        <Border Grid.Row="2"
                StrokeThickness="1"
                Stroke="#33FFFFFF"
                BackgroundColor="#1A1A1A"
                Padding="15, 10">
            <Grid RowDefinitions="Auto, *">
                
                <!-- Translation Title Bar -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                    <Label Grid.Column="0"
                           x:Name="TranslationSectionTitle"
                           Text="Türkçe Meali"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#00BCD4"
                           VerticalOptions="Center"/>
                    
                    <Label Grid.Column="1"
                           x:Name="PageNumberLabel"
                           Text="Sayfa 1"
                           FontSize="14"
                           TextColor="#CCCCCC"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGoToPageClicked"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- Scrollable verses list -->
                <ScrollView Grid.Row="1">
                    <Grid>
                        <VerticalStackLayout x:Name="TranslationListContainer" Spacing="15" Padding="0,5"/>
                        
                        <ActivityIndicator x:Name="TranslationLoadingIndicator"
                                           IsRunning="False"
                                           IsVisible="False"
                                           Color="#00BCD4"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           HeightRequest="40" WidthRequest="40"/>
                    </Grid>
                </ScrollView>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
